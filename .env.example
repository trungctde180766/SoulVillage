# ==========================================
# HỒN LÀNG (SOULVILLAGE) - ENVIRONMENT VARIABLES
# ==========================================
# SAO CHÉP FILE NÀY THÀNH .env.local ĐỂ SỬ DỤNG CHO LOCAL DEVELOPMENT
# TUYỆT ĐỐI KHÔNG COMMIT .env.local HOẶC CÁC SECRET LÊN GIT!

# 1. Google Gemini API (Lấy từ https://aistudio.google.com/api-keys)
# Lưu ý: Không dùng tiền tố VITE_ để tránh lộ key ra phía client
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. MongoDB Atlas Connection (Lấy từ MongoDB Atlas Dashboard -> Connect -> Node.js)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="soulvillage"

# 3. Server Configuration
NODE_ENV="development"
PORT=3000

