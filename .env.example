# ==========================================
# HỒN LÀNG (SOULVILLAGE) - ENVIRONMENT VARIABLES (PLACEHOLDER)
# ==========================================
# Sao chép file này thành .env.local để sử dụng trên máy local.
# Tuyệt đối không commit file secret lên git.

# 1. Google Gemini API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. MongoDB Atlas Connection
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="soulvillage"

# 3. Google Cloud Run / Server Configuration
NODE_ENV="development"
PORT=8080
